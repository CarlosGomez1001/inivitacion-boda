DATABASE_URL="postgresql://invitacion:changeme@localhost:5432/invitacion_boda"
JWT_SECRET="changeme-generate-a-real-secret"
JWT_EXPIRES_IN="8h"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

