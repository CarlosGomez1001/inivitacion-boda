DATABASE_URL="postgresql://invitacion:changeme@localhost:5432/invitacion_boda"
JWT_SECRET="changeme-generate-a-real-secret"
JWT_EXPIRES_IN="8h"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Usados solo por `npm run seed` para crear el primer admin.
# Si no los defines, se usa admin@invitacion.local y una contraseña aleatoria
# que se imprime en consola al correr el seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Ruta del Excel para `npm run import:invitados`.
# En local no hace falta (se resuelve solo a ../src/data/Lista_invitados.xlsx).
# Corriendo dentro de Docker (Fase 2.7), usar la ruta montada en el contenedor:
# EXCEL_INVITADOS_PATH=/app/data/Lista_invitados.xlsx
